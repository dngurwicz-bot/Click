# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Billing / Invoice fallback issuer details
COMPANY_NAME_HE=חברת CLICK בע"מ
COMPANY_NAME_EN=CLICK Ltd.
COMPANY_TAX_ID=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=

# Google Gemini (optional — AI features)
GEMINI_API_KEY=your-gemini-api-key
